# Flutter Mobile App Environment Variables
# Copy to .env and fill in values

# ASP.NET Core API base URL
# Android emulator: http://10.0.2.2:5097/api
# iOS simulator:    http://localhost:5097/api
# Physical device:  http://<dev-machine-ip>:5097/api
API_BASE_URL=http://10.0.2.2:5097/api

# Do NOT put secrets, passwords, or tokens here.
# Flutter env files are compiled into the app bundle.
