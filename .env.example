# =============================================================================
# Insurance Claims Processing System — Environment Configuration Template
# =============================================================================
# DO NOT commit real secrets or API keys to version control.
# Copy this template to .env or supply variables via your local environment.

# ── Payment Gateway Configuration (Phase 1: Mock Provider / Phase 2: PayPal Sandbox)
PAYMENT_GATEWAY_PROVIDER=Mock
PAYMENT_GATEWAY_MOCK_OUTCOME=success

# ── PayPal Sandbox Configuration (Phase 2) ────────────────────────────────────
# Set PAYMENT_GATEWAY_PROVIDER=PayPalSandbox to enable PayPal Sandbox adapter
PAYPAL_MODE=Sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
